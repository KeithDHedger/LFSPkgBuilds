#!/bin/bash -e

. /usr/share/LFSPkg/LFSFunctions

trap 'echo -e "$0 ${RED}FAILED${NORMAL} at line ${GREEN}${LINENO}${NORMAL}"' ERR

DEPENDS="qt5-5.15.2"
if ! lfspkg -B "$DEPENDS";then
	exit 100
fi

PKGNAME="SimulIDE"
TARNAME="simulide"
VERSION="1.1.0"
BUILD=1
SECTION="ELECTRONICS"
SUFFIX="LFSPKG"
TARBALL="${PKGNAME}_${VERSION}-SR0_sources.zip"
PKG="${OUTPUT}/${PKGNAME}"
DOWHAT=${1:-"build"}
CWD=$(pwd)

scriptLog "${PKGNAME}-${VERSION}"
gettar "https://launchpad.net/simulide/${VERSION}/${VERSION}-sr0/+download/$TARBALL"  $SECTION
rm -rf "$PKG" || true
mkdir -p "$PKG"

pushd $COMPILEAT 2>/dev/null||true
	extractarchive "${SOURCEARCHIVES}/${SECTION}/${TARBALL}"
	pushd "${PKGNAME}_${VERSION}-SR0_sources"
		cd build_XX
		qmake
		make $MAKEFLAGS|| exit 100
		install -D -m644 ${CWD}/simulide.desktop "${PKG}/usr/share/applications/SimulIDE.desktop"
		mkdir -vp ${PKG}/usr/share/pixmaps ${PKG}/opt
		cp ${CWD}/simulide.png ${PKG}/usr/share/pixmaps
		cp -rvp executables/SimulIDE_1.1.0-SR0 ${PKG}/opt
	popd

	checketc "$PKG"
	packageclean "$PKG" "$CWD"

	pushd "$PKG"
		lfspkg -n "$PKGNAME" -p "$VERSION" -d $SECTION -b $BUILD -s $SUFFIX -m
	popd

	case $DOWHAT in
		up*)
			lfspkg "^${PKGNAME}-[0-9][0-9]*" "${PKGARCHIVES}/${SECTION}/${PKGNAME}-${VERSION}-${BUILD}_${SECTION}_${SUFFIX}.tar.gz" -u
			;;
		"install")
			lfspkg "${PKGARCHIVES}/${SECTION}/${PKGNAME}-${VERSION}-${BUILD}_${SECTION}_${SUFFIX}.tar.gz" -i
			;;
		"build")
			echo "Just built"
			;;
		*)
			echo "*** Unknown command ***"
			exit 1
	esac

	rm -r "$PKG" "${PKGNAME}_${VERSION}-SR0_sources"
popd 2>/dev/null||true
